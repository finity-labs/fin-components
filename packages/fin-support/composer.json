{
    "name": "finity-labs/fin-support",
    "description": "Shared support code for Finity Labs Filament plugins: page access through Filament Shield or a Gate ability, installer helpers for panel providers and the Shield config, and per-panel policy registration.",
    "keywords": [
        "laravel",
        "filament",
        "shield",
        "console"
    ],
    "homepage": "https://github.com/finity-labs/fin-support",
    "license": "MIT",
    "authors": [
        {
            "name": "Finity Labs",
            "email": "filament.infinity@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "finity-labs/lin-support": "^0.1",
        "illuminate/contracts": "^11.28|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "bezhansalleh/filament-shield": "Page permissions through HasPageShieldSupport (^4.0)."
    },
    "repositories": [
        {
            "type": "path",
            "url": "../lin-support*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "FinityLabs\\FinSupport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FinityLabs\\FinSupport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
